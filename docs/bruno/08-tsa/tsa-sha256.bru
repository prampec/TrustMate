meta {
  name: POST /v1/tsa (SHA-256, no nonce)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/tsa
  body: file
  auth: none
}

body:file {
  file: @file(fixtures/ts-req-sha256.der) @contentType(application/timestamp-query)
}

assert {
  res.status: 200
}

docs {
  Verify offline: openssl ts -reply -in <response body> -text
}
