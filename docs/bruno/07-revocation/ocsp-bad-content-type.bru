meta {
  name: POST /v1/ocsp (wrong Content-Type -> 415)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/ocsp
  body: file
  auth: none
}

body:file {
  file: @file(fixtures/ocsp-req-unknown.der) @contentType(text/plain)
}

assert {
  res.status: 415
  res.body.type: urn:trustmate:problem:unsupported-media-type
}
