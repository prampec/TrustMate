meta {
  name: POST /v1/certificates (garbage CSR -> 400)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/certificates
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "profile": "document-signing",
    "csr": "-----BEGIN CERTIFICATE REQUEST-----\nbm90IGEgcmVhbCBjc3I=\n-----END CERTIFICATE REQUEST-----"
  }
}

assert {
  res.status: 400
}

docs {
  Server should echo a Go ASN.1 parser error inside {"error": "invalid CSR: ..."}.
}
