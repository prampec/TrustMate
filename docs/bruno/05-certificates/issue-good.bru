meta {
  name: POST /v1/certificates (document-signing, happy path)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/certificates
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "profile": "document-signing",
    "csr": {{csrDocumentSigning}}
  }
}

assert {
  res.status: 201
  res.body.profile: document-signing
}

vars:post-response {
  goodSerial: res.body.serial
  goodPem: res.body.pem
}

docs {
  Requires manager (or admin) role. {{csrDocumentSigning}} is injected via
  --env-var by scripts/run-all.sh. This certificate is kept valid (never
  revoked) for the rest of the run so 07-revocation/ocsp-good.bru has a
  real "good" serial to query.
}
